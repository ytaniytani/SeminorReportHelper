# このファイルを .env にコピーして値を埋めてください。.env はコミットされません。

# ---- レポート生成 LLM ----
# 使用するプロバイダ: claude | openai | ollama
SRH_LLM_PROVIDER=claude

# claude を使う場合
ANTHROPIC_API_KEY=
SRH_CLAUDE_MODEL=claude-sonnet-5

# openai を使う場合
OPENAI_API_KEY=
SRH_OPENAI_MODEL=gpt-4o

# ollama を使う場合(ローカル完結。Vision は自動でスキップされます)
SRH_OLLAMA_HOST=http://localhost:11434
SRH_OLLAMA_MODEL=qwen2.5:14b

# ---- 文字起こし ----
# tiny | base | small | medium | large-v3
SRH_WHISPER_MODEL=medium
# cpu | cuda | auto
SRH_WHISPER_DEVICE=auto
# 音声の言語。空なら自動判定
SRH_WHISPER_LANGUAGE=

# ---- レポート ----
# 出力言語
SRH_REPORT_LANGUAGE=日本語

# ---- Confluence ----
# 例: https://your-org.atlassian.net
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=
